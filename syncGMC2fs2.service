#
# For gliderfs2
#
# The service script for running syncGMC.py
# which syncs /var/opt/sfmc-dockserver/stations to a remote
#
# copy this file to /etc/systemd/system
#
# sudo cp syncGMC2fs2.service /etc/systemd/system/
#
# March-2019, Pat Welch, pat@mousebrains.com

[Unit]
Description=Sync /var/opt/sfmc-dockserver/stations to gliderfs2:/data/Dockserver/gliderfmc0
After=network-online.target
Wants=network-online.target

[Service]
# Type=simple # Default
User=pat
Group=pat
SupplementaryGroups=localuser
WorkingDirectory=/home/pat/logs
#
# See /home/pat/.ssh/config for where fs2 points to and which identity file it uses
# On gliderfs2 the key is restricted via rrsync -wo to /data/Dockserver/gliderfmc0,
# so the target path is relative to that directory
#
ExecStart=/home/pat/bin/syncGMC.py \
	--rsyncTarget=fs2:/ \
	--rsyncExclude=.archived-deployments \
	--exclude=.archived-deployments \
	--trigger=/archive \
	--trigger=/configuration \
	--trigger=/from-glider \
	--trigger=/to-glider \
	--trigger=/to-science \
	--trigger=/gliderState.xml\
	--logfile=/home/pat/logs/fs2.log \
	--mailTo=pat.welch@oregonstate.edu \
	/var/opt/sfmc-dockserver/stations
RestartSec=300
Restart=always
#
# Hardening, check with: systemd-analyze security syncGMC2fs2
#
# Filesystem: everything read-only except the log directory
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pat/logs
PrivateTmp=yes
PrivateMounts=yes
PrivateDevices=yes
# Privileges
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
# Kernel
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# Network: ssh to gliderfs2 and SMTP to localhost
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Misc
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0022
# Resources: no core dumps, which could contain the ssh key, and bounded usage
LimitCORE=0
MemoryMax=512M
TasksMax=50

[Install]
WantedBy=multi-user.target
